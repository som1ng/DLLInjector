    "doctor_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "severity",
        "message",
        "evidence",
        "confidence",
        "recommended_next_step",
        "documentation"
      ],
      "properties": {
        "rule_id": {
          "enum": [
            "MALFORMED_PE",
            "NOT_A_DLL",
            "ARCH_MISMATCH",
            "INSUFFICIENT_EVIDENCE",
            "POSSIBLE_MISSING_DEPENDENCY"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "description"
            ],
            "properties": {
              "source": {
                "enum": [
                  "static_analysis",
                  "user_supplied_option",
                  "filesystem_observation"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "confidence": {
          "enum": [
            "high",
            "low"
          ]
        },
        "recommended_next_step": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://learn\\.microsoft\\.com/[^\\s]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule_id": {
                "const": "POSSIBLE_MISSING_DEPENDENCY"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "warning"
              },
              "confidence": {
                "const": "low"
              }
            }
          },
          "else": {
            "allOf": [
              {
                "properties": {
                  "confidence": {
                    "const": "high"
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "rule_id": {
                      "const": "INSUFFICIENT_EVIDENCE"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "severity": {
                      "enum": [
                        "info",
                        "warning"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "target_architecture",
        "image",
        "inspection_error",
        "dependencies"
      ],
      "properties": {
        "scope": {
          "const": "static_dll_preflight"
        },
        "target_architecture": {
          "enum": [
            "x86",
            "x64",
            null
          ]
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "machine",
                "characteristics",
                "format",
                "has_clr_header",
                "import_library_count",
                "delay_import_library_count"
              ],
              "properties": {
                "machine": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "characteristics": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "format": {
                  "enum": [
                    "PE32",
                    "PE32+"
                  ]
                },
                "has_clr_header": {
                  "type": "boolean"
                },
                "import_library_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "delay_import_library_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "inspection_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/dependencies"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "image": {
              "type": "object"
            },
            "inspection_error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "image": {
              "type": "null"
            },
            "inspection_error": {
              "allOf": [
                {
                  "$ref": "#/$defs/error"
                },
                {
                  "properties": {
                    "category": {
                      "const": "malformed_pe"
                    }
                  }
                }
              ]
            },
            "dependencies": {
              "type": "null"
            }
          }
        }
      ]
    },
    "dependency_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory_index",
        "status",
        "error"
      ],
      "properties": {
        "directory_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "status": {
          "enum": [
            "file",
            "not_found",
            "not_file",
            "unavailable"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "dependency_library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "status",
        "candidates"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "import",
            "delay_import"
          ]
        },
        "status": {
          "enum": [
            "candidate_found",
            "not_found_in_search_dirs",
            "inconclusive",
            "api_set_unresolved",
            "unsupported_name"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/dependency_candidate"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "api_set_unresolved",
                  "unsupported_name"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "candidates": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate_found"
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "file"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_found_in_search_dirs"
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "not_found",
                        "not_file"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "inconclusive"
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    }
                  }
                },
                "items": {
                  "properties": {
                    "status": {
                      "not": {
                        "const": "file"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "filesystem_view",
        "search_directories",
        "libraries"
      ],
      "properties": {
        "scope": {
          "const": "explicit_directories"
        },
        "filesystem_view": {
          "const": "caller_process"
        },
        "search_directories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32767
          }
        },
        "libraries": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/dependency_library"
          }
        }
      }
    }
  }
