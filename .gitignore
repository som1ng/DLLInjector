# ====================================================================
# DLL-Injector 项目 .gitignore 配置
# ====================================================================

# --------------------------------------------------------------------
# 1. 构建系统与编译器生成目录 (CMake / Visual Studio / CLion)
# --------------------------------------------------------------------
/build/
/out/
/cmake-build-*/
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
/CMakeUserPresets.json
_deps/

# --------------------------------------------------------------------
# 2. 编译中间文件与调试符号 (MSVC / GCC / Clang)
# --------------------------------------------------------------------
*.obj
*.o
*.lib
*.a
*.exp
*.ilk
*.pdb
*.idb
*.ipdb
*.tlog
*.log
*.pch
*.gch
*.manifest
*.dmp
*.mdmp
*.crash

# --------------------------------------------------------------------
# 3. 产物目录与预编译成品 (bin/)
# 本地旧版成品不提交；当前产物从 CMake 构建或 CI Artifacts 获取
# --------------------------------------------------------------------
/bin/
# 旧样例的编译产物；保留源代码，测试 fixture 由 CMake 生成
/dll_test/**/*.exe
/dll_test/**/*.dll

# --------------------------------------------------------------------
# 4. IDE 与编辑器临时文件
# --------------------------------------------------------------------
# Visual Studio
.vs/
x64/
x86/
ARM/
ARM64/
Debug/
Release/
*.VC.db
*.VC.opendb
*.suo
*.user
*.userosv
*.sln.docstates

# VS Code (保留 launch.json, tasks.json 等配置，仅忽略缓存)
.vscode/ipch/
.vscode/*.db
.vscode/.browse.*

# JetBrains (CLion / PyCharm 等)
.idea/

# 编辑器临时与备份文件
*.swp
*.swo
*~
*.bak

# --------------------------------------------------------------------
# 5. Python 测试与虚拟环境
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
ENV/

# --------------------------------------------------------------------
# 6. 本地报告、分析产物与缓存
# --------------------------------------------------------------------
/reports/
/artifacts/

# Local MCP dependencies and generated distribution
/integrations/mcp/node_modules/
/integrations/mcp/dist/
/integrations/mcp/*.tgz

# Browser regression dependencies and generated output
/tests/gui/node_modules/
/tests/gui/test-results/

# Pi package resources are generated from the canonical Skill
/integrations/pi/dist/
/integrations/pi/*.tgz

# Local installer dependencies and project MCP ownership records
/integrations/installer/node_modules/
/integrations/npm/node_modules/
/integrations/npm/*.tgz
**/.dll-doctor/
**/.dll-doctor-config-*.tmp

# Local Skill installations carry machine-specific CLI paths
**/.agents/skills/windows-dll-doctor/
**/.claude/skills/windows-dll-doctor/
**/.dll-doctor-stage-*/
**/.dll-doctor-installer.lock
**/.dll-doctor-recovery-*.tmp
**/.dll-doctor-recover.guard

# --------------------------------------------------------------------
# 7. 操作系统临时文件
# --------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# --------------------------------------------------------------------
# 8. 项目本地私有文件
# --------------------------------------------------------------------
重构升级计划.md
AGENTS.md
