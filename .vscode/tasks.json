{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure: MSVC x64",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "msvc-x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: DLLInjector x64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "msvc-x64-debug",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure: MSVC x64",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Test: DLLInjector x64 Debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "msvc-x64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build: DLLInjector x64 Debug",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
