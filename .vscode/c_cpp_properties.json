{
  "version": 4,
  "configurations": [
    {
      "name": "Windows MSVC x64",
      "compilerPath": "cl.exe",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/apps/cli",
        "${workspaceFolder}/core",
        "${workspaceFolder}/src"
      ],
      "defines": [
        "UNICODE",
        "_UNICODE",
        "NOMINMAX",
        "_WIN32_WINNT=0x0600",
        "DLLINJECTOR_HAS_SYSCALL=0"
      ],
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
